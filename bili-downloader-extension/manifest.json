{
  "manifest_version": 3,
  "name": "Bili MP3 Downloader",
  "version": "1.0",
  "description": "发送 B 站收藏夹 HTML 到本地接收端",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "http://localhost:52025/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bili-mp3-downloader@iox.com"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}